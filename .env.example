# Supabase (Dashboard → Project Settings → API)
REACT_APP_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
REACT_APP_SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# 질문 타로 AI 답변 (Supabase Edge Function 'tarot-reading' 배포 후 true)
# OpenAI 키는 여기에 넣지 마세요! → supabase secrets set OPENAI_API_KEY=sk-...
REACT_APP_ENABLE_AI_READING=false
